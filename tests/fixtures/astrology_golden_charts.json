  "known_defects": {
    "chiron_absent": "AstrologicalCalculator.get_planetary_positions returns 11 bodies, not 12: core/astrology.py calls swe.set_ephe_path('') and no .se1 files are present, so swe.calc_ut(jd, swe.CHIRON) raises \"SwissEph file 'seas_18.se1' not found\" and the surrounding `except Exception: pass` swallows it.",
    "no_south_node": "Only north_node (swe.MEAN_NODE) is exposed. core/astrology.py contains no south node and no true node.",
    "high_latitude_raises": "get_western_astrology hardcodes Placidus and does not check the return code; swe.houses raises for |lat| >= 67 degrees in both hemispheres and the exception propagates uncaught.",
    "natal_chart_no_lunar_nodes": "backend/core/services/astrology_chart_service.py asks a Kerykeion subject for 'mean_node'/'true_node', but kerykeion 6.0.4 names them mean_north_lunar_node / true_north_lunar_node (and the south equivalents), so getattr(..., None) yields None and the chart is returned with no nodes and no error."
  },
